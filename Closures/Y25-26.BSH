! Baseline simulation shock file for 2026
! Data based on IMF WEO April 2025 Release
! Aggregations and calculations by the model.

! Real GDP Growth Rate (%)
Shock qgdp("ZAF") = 1.38;
Shock qgdp("USA") = 1.85;
Shock qgdp("SACUSADC") = 3.67;
Shock qgdp("CHN") = 3.90;
Shock qgdp("EU27") = 1.58;
Shock qgdp("GBR") = 1.69;
Shock qgdp("ROW") = 3.25;

! Population Growth Rate (%)
Shock pop("ZAF") = 1.05;
Shock pop("USA") = 0.44;
Shock pop("SACUSADC") = 1.68;
Shock pop("CHN") = -0.22;
Shock pop("EU27") = 0.10;
Shock pop("GBR") = 0.24;
Shock pop("ROW") = 0.85;

! Unskilled Labour Growth Rate (%) - Assumed equal to Population Growth
Shock qfactsup("UnSkLab","ZAF") = 1.05;
Shock qfactsup("UnSkLab","USA") = 0.44;
Shock qfactsup("UnSkLab","SACUSADC") = 1.68;
Shock qfactsup("UnSkLab","CHN") = -0.22;
Shock qfactsup("UnSkLab","EU27") = 0.10;
Shock qfactsup("UnSkLab","GBR") = 0.24;
Shock qfactsup("UnSkLab","ROW") = 0.85;

! Skilled Labour Growth Rate (%) - Assumed equal to Population Growth
Shock qfactsup("SkLab","ZAF") = 1.05;
Shock qfactsup("SkLab","USA") = 0.44;
Shock qfactsup("SkLab","SACUSADC") = 1.68;
Shock qfactsup("SkLab","CHN") = -0.22;
Shock qfactsup("SkLab","EU27") = 0.10;
Shock qfactsup("SkLab","GBR") = 0.24;
Shock qfactsup("SkLab","ROW") = 0.85;

! Investment Growth Rate (%)
Shock sqcgdsreg("ZAF") = 3.15;
Shock sqcgdsreg("USA") = 1.95;
Shock sqcgdsreg("SACUSADC") = 4.33;
Shock sqcgdsreg("CHN") = 3.85;
Shock sqcgdsreg("EU27") = 2.11;
Shock sqcgdsreg("GBR") = 2.25;
Shock sqcgdsreg("ROW") = 4.01;

Shock time = 1 ;