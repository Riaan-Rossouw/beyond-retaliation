! Baseline simulation shock file for 2028
! Data based on IMF WEO April 2025 Release
! Aggregations and calculations by the model.

! Real GDP Growth Rate (%)
Shock qgdp("ZAF") = 1.48;
Shock qgdp("USA") = 1.80;
Shock qgdp("SACUSADC") = 3.90;
Shock qgdp("CHN") = 3.50;
Shock qgdp("EU27") = 1.42;
Shock qgdp("GBR") = 1.80;
Shock qgdp("ROW") = 3.14;

! Population Growth Rate (%)
Shock pop("ZAF") = 0.97;
Shock pop("USA") = 0.42;
Shock pop("SACUSADC") = 1.60;
Shock pop("CHN") = -0.29;
Shock pop("EU27") = 0.06;
Shock pop("GBR") = 0.20;
Shock pop("ROW") = 0.79;

! Unskilled Labour Growth Rate (%) - Assumed equal to Population Growth
Shock qfactsup("UnSkLab","ZAF") = 0.97;
Shock qfactsup("UnSkLab","USA") = 0.42;
Shock qfactsup("UnSkLab","SACUSADC") = 1.60;
Shock qfactsup("UnSkLab","CHN") = -0.29;
Shock qfactsup("UnSkLab","EU27") = 0.06;
Shock qfactsup("UnSkLab","GBR") = 0.20;
Shock qfactsup("UnSkLab","ROW") = 0.79;

! Skilled Labour Growth Rate (%) - Assumed equal to Population Growth
Shock qfactsup("SkLab","ZAF") = 0.97;
Shock qfactsup("SkLab","USA") = 0.42;
Shock qfactsup("SkLab","SACUSADC") = 1.60;
Shock qfactsup("SkLab","CHN") = -0.29;
Shock qfactsup("SkLab","EU27") = 0.06;
Shock qfactsup("SkLab","GBR") = 0.20;
Shock qfactsup("SkLab","ROW") = 0.79;

! Investment Growth Rate (%)
Shock sqcgdsreg("ZAF") = 3.35;
Shock sqcgdsreg("USA") = 1.85;
Shock sqcgdsreg("SACUSADC") = 4.51;
Shock sqcgdsreg("CHN") = 3.61;
Shock sqcgdsreg("EU27") = 1.87;
Shock sqcgdsreg("GBR") = 2.35;
Shock sqcgdsreg("ROW") = 3.85;

Shock time = 1 ;