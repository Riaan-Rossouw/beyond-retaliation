shock tms("Auto","USA","EU27") =   8.8705 ; ! base  7.946%
shock tms("MachEquip","USA","EU27") =   9.4538 ; ! base  1.003%
shock tms("ChemPlast","USA","EU27") =   9.3325 ; ! base  2.376%
