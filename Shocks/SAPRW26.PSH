shock tms("LiveMeat","USA","GBR") =   9.4618 ; ! base  0.914%
shock tms("OthAgFood","USA","GBR") =   8.9477 ; ! base  6.974%
shock tms("Coal","USA","GBR") =   9.5445 ; ! base  0.000%
shock tms("Mining","USA","GBR") =   9.5443 ; ! base  0.002%
shock tms("Metals","USA","GBR") =   9.4820 ; ! base  0.689%
shock tms("Auto","USA","GBR") =   9.1862 ; ! base  4.078%
shock tms("MachEquip","USA","GBR") =   9.4306 ; ! base  1.263%
shock tms("ChemPlast","USA","GBR") =   9.3434 ; ! base  2.250%
