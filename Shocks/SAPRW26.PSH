shock tms("OthManuf","USA","GBR") =   9.4395 ; ! base  1.163%

! --- ZAF on USA goods: netted into the tariff-cut block above
! --- SACUSADC on USA goods: +10pp in total
shock tms("GrainCrop","USA","SACUSADC") =   4.3216 ; ! base 13.252%
shock tms("LiveMeat","USA","SACUSADC") =   4.0407 ; ! base 21.290%
shock tms("OthAgFood","USA","SACUSADC") =   4.4313 ; ! base 10.387%
