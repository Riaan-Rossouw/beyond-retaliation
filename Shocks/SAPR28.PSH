! Scenario 2: SA policy response. Period 2028.

!======================================================================
! Real exchange rate adjustment -- step 3 of 5
!======================================================================
! Trade-balance-to-income RATIO raised by +0.00030 per year
! over 2026-2030, i.e. +0.00150 cumulatively
! (+0.150 percentage points of regional income).
! Calibrated to deliver a 0.10% cumulative real
! depreciation -- the minimum sufficient to offset the aggregate
! impact of the USA tariff shock.
! Requires Swap dpsave("ZAF") = DTBALR("ZAF") in the closure.
! The real depreciation is the model's ENDOGENOUS response to this,
! not an imposed price.  Read it off pfactor(ZAF) minus pfactwld.
! 
! MUST be 'ashock': DTBALR is exogenous under POL2/POL3, so RunDynam
! also writes a base-case shock for it.  'shock' would specify the
! same component twice and GEMPACK would stop.
! 
! CALIBRATE this value - see README section 6.
!======================================================================

ashock DTBALR("ZAF") =   0.00030 ;

!======================================================================
! South African import tariffs -- step 3 of 5
!======================================================================
! Applied rates cut to 70% of their initial level.
! 'uniform -50' on tms is NOT equivalent to halving the tariff RATE:
! it halves the POWER (1+t), driving every rate to about -50%, i.e.
! an import subsidy.  Shocks are therefore element-specific.
!======================================================================

shock tms("GrainCrop","USA","ZAF") =  -0.2719 ; !   2.223% ->   1.945%
shock tms("GrainCrop","CHN","ZAF") =  -0.3869 ; !   3.194% ->   2.795%
shock tms("GrainCrop","ROW","ZAF") =  -0.4809 ; !   4.001% ->   3.501%
shock tms("LiveMeat","USA","ZAF") =  -1.1199 ; !   9.841% ->   8.611%
shock tms("LiveMeat","CHN","ZAF") =  -0.2729 ; !   2.232% ->   1.953%
shock tms("LiveMeat","EU27","ZAF") =  -0.1157 ; !   0.934% ->   0.817%
shock tms("LiveMeat","GBR","ZAF") =  -0.0843 ; !   0.679% ->   0.594%
shock tms("LiveMeat","ROW","ZAF") =  -0.9385 ; !   8.118% ->   7.103%
shock tms("OthAgFood","USA","ZAF") =  -0.6104 ; !   5.134% ->   4.492%
shock tms("OthAgFood","SACUSADC","ZAF") =  -0.0010 ; !   0.008% ->   0.007%
shock tms("OthAgFood","CHN","ZAF") =  -0.5918 ; !   4.969% ->   4.348%
shock tms("OthAgFood","EU27","ZAF") =  -0.0862 ; !   0.695% ->   0.608%
shock tms("OthAgFood","GBR","ZAF") =  -0.0498 ; !   0.400% ->   0.350%
shock tms("OthAgFood","ROW","ZAF") =  -0.5822 ; !   4.885% ->   4.275%
shock tms("Mining","USA","ZAF") =  -0.0021 ; !   0.017% ->   0.014%
shock tms("Mining","CHN","ZAF") =  -0.0003 ; !   0.003% ->   0.002%
shock tms("Mining","ROW","ZAF") =  -0.0000 ; !   0.000% ->   0.000%
shock tms("Metals","USA","ZAF") =  -0.2578 ; !   2.105% ->   1.842%
shock tms("Metals","CHN","ZAF") =  -0.7310 ; !   6.212% ->   5.435%
shock tms("Metals","EU27","ZAF") =  -0.0124 ; !   0.099% ->   0.087%
shock tms("Metals","GBR","ZAF") =  -0.0253 ; !   0.203% ->   0.178%
shock tms("Metals","ROW","ZAF") =  -0.3243 ; !   2.663% ->   2.330%
shock tms("Auto","USA","ZAF") =  -1.4638 ; !  13.263% ->  11.606%
shock tms("Auto","CHN","ZAF") =  -1.2920 ; !  11.528% ->  10.087%
shock tms("Auto","EU27","ZAF") =  -0.7791 ; !   6.647% ->   5.816%
shock tms("Auto","GBR","ZAF") =  -0.8833 ; !   7.604% ->   6.653%
shock tms("Auto","ROW","ZAF") =  -1.6340 ; !  15.038% ->  13.158%
shock tms("MachEquip","USA","ZAF") =  -0.1873 ; !   1.521% ->   1.331%
shock tms("MachEquip","CHN","ZAF") =  -0.3591 ; !   2.958% ->   2.588%
