! Scenario 6: USA tariff shock + South African retaliation ONLY. Period 2027.
! 2025 uses TTSS25.PSH (identical to Scenario 1).

!======================================================================
! South African retaliatory tariff on USA goods -- phase 2 of 2
!======================================================================
! +10 percentage points on the applied rate, phased half in 2026
! and half in 2027 (Table 7, ZAF row).
! 
! NO third-country tariffs and NO unilateral tariff cut.  Scenario 6
! differs from Scenario 1 ONLY by South Africa's own retaliation, so
! Sc6 - Sc1 isolates the effect of retaliating.  This is the clean test
! of Research Question 1; Scenario 3 cannot answer it because it bundles
! retaliation with USA tariffs on China, the EU and others.
!======================================================================

shock tms("GrainCrop","USA","ZAF") =   4.6391 ; !   7.779% ->  12.779%
shock tms("LiveMeat","USA","ZAF") =   4.2625 ; !  17.302% ->  22.302%
shock tms("OthAgFood","USA","ZAF") =   4.4876 ; !  11.418% ->  16.418%
shock tms("Coal","USA","ZAF") =   4.7619 ; !   5.000% ->  10.000%
shock tms("Mining","USA","ZAF") =   4.7610 ; !   5.021% ->  10.021%
shock tms("Metals","USA","ZAF") =   4.6455 ; !   7.632% ->  12.632%
shock tms("Auto","USA","ZAF") =   4.1125 ; !  21.579% ->  26.579%
shock tms("MachEquip","USA","ZAF") =   4.6772 ; !   6.901% ->  11.901%
shock tms("ChemPlast","USA","ZAF") =   4.5869 ; !   9.005% ->  14.005%
shock tms("TexApp","USA","ZAF") =   4.0951 ; !  22.096% ->  27.096%
shock tms("OthManuf","USA","ZAF") =   4.6151 ; !   8.341% ->  13.341%
