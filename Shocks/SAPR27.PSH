shock tms("TexApp","USA","ZAF") =  -1.4816 ; !  15.386% ->  13.677%
shock tms("TexApp","SACUSADC","ZAF") =  -0.0000 ; !   0.000% ->   0.000%
shock tms("TexApp","CHN","ZAF") =  -2.4411 ; !  28.156% ->  25.027%
shock tms("TexApp","EU27","ZAF") =  -1.2354 ; !  12.509% ->  11.119%
