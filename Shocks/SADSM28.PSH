! Scenario 5: SA policy + world response + DSM realisation. Period 2028.
! Nests the complete Scenario 4 shock set for this year.

!======================================================================
! Real exchange rate adjustment -- step 3 of 5
!======================================================================
! Trade-balance-to-income RATIO raised by +0.00030 per year
! over 2026-2030, i.e. +0.00150 cumulatively
! (+0.150 percentage points of regional income).
! Calibrated to deliver a 0.10% cumulative real
! depreciation -- the minimum sufficient to offset the aggregate
! impact of the USA tariff shock.
! Requires Swap dpsave("ZAF") = DTBALR("ZAF") in the closure.
! The real depreciation is the model's ENDOGENOUS response to this,
! not an imposed price.  Read it off pfactor(ZAF) minus pfactwld.
! 
! MUST be 'ashock': DTBALR is exogenous under POL2/POL3, so RunDynam
! also writes a base-case shock for it.  'shock' would specify the
! same component twice and GEMPACK would stop.
! 
! CALIBRATE this value - see README section 6.
!======================================================================

ashock DTBALR("ZAF") =   0.00030 ;

!======================================================================
! South African import tariffs -- step 3 of 5
!======================================================================
! Applied rates cut to 70% of their initial level.
! 'uniform -50' on tms is NOT equivalent to halving the tariff RATE:
! it halves the POWER (1+t), driving every rate to about -50%, i.e.
! an import subsidy.  Shocks are therefore element-specific.
! 
! NETTED with the 10pp retaliatory tariff on USA
! goods (Table 7), phased half in 2026 and half in 2027.  For the
! USA source these two policies act on the same component and are
! combined into a single shock below.
!======================================================================

shock tms("GrainCrop","USA","ZAF") =  -0.2476 ; !  12.223% ->  11.945%  [cut + retaliation]
shock tms("GrainCrop","CHN","ZAF") =  -0.3869 ; !   3.194% ->   2.795%
shock tms("GrainCrop","ROW","ZAF") =  -0.4809 ; !   4.001% ->   3.501%
shock tms("LiveMeat","USA","ZAF") =  -1.0265 ; !  19.841% ->  18.611%  [cut + retaliation]
shock tms("LiveMeat","CHN","ZAF") =  -0.2729 ; !   2.232% ->   1.953%
shock tms("LiveMeat","EU27","ZAF") =  -0.1157 ; !   0.934% ->   0.817%
shock tms("LiveMeat","GBR","ZAF") =  -0.0843 ; !   0.679% ->   0.594%
shock tms("LiveMeat","ROW","ZAF") =  -0.9385 ; !   8.118% ->   7.103%
shock tms("OthAgFood","USA","ZAF") =  -0.5574 ; !  15.134% ->  14.492%  [cut + retaliation]
shock tms("OthAgFood","SACUSADC","ZAF") =  -0.0010 ; !   0.008% ->   0.007%
shock tms("OthAgFood","CHN","ZAF") =  -0.5918 ; !   4.969% ->   4.348%
shock tms("OthAgFood","EU27","ZAF") =  -0.0862 ; !   0.695% ->   0.608%
shock tms("OthAgFood","GBR","ZAF") =  -0.0498 ; !   0.400% ->   0.350%
shock tms("OthAgFood","ROW","ZAF") =  -0.5822 ; !   4.885% ->   4.275%
shock tms("Coal","USA","ZAF") =   0.0000 ; !  10.000% ->  10.000%  [cut + retaliation]
shock tms("Mining","USA","ZAF") =  -0.0019 ; !  10.017% ->  10.014%  [cut + retaliation]
shock tms("Mining","CHN","ZAF") =  -0.0003 ; !   0.003% ->   0.002%
shock tms("Mining","ROW","ZAF") =  -0.0000 ; !   0.000% ->   0.000%
shock tms("Metals","USA","ZAF") =  -0.2348 ; !  12.105% ->  11.842%  [cut + retaliation]
shock tms("Metals","CHN","ZAF") =  -0.7310 ; !   6.212% ->   5.435%
shock tms("Metals","EU27","ZAF") =  -0.0124 ; !   0.099% ->   0.087%
shock tms("Metals","GBR","ZAF") =  -0.0253 ; !   0.203% ->   0.178%
shock tms("Metals","ROW","ZAF") =  -0.3243 ; !   2.663% ->   2.330%
shock tms("Auto","USA","ZAF") =  -1.3450 ; !  23.263% ->  21.606%  [cut + retaliation]
shock tms("Auto","CHN","ZAF") =  -1.2920 ; !  11.528% ->  10.087%
shock tms("Auto","EU27","ZAF") =  -0.7791 ; !   6.647% ->   5.816%
shock tms("Auto","GBR","ZAF") =  -0.8833 ; !   7.604% ->   6.653%
shock tms("Auto","ROW","ZAF") =  -1.6340 ; !  15.038% ->  13.158%
shock tms("MachEquip","USA","ZAF") =  -0.1705 ; !  11.521% ->  11.331%  [cut + retaliation]
shock tms("MachEquip","CHN","ZAF") =  -0.3591 ; !   2.958% ->   2.588%
shock tms("MachEquip","EU27","ZAF") =  -0.0140 ; !   0.112% ->   0.098%
shock tms("MachEquip","GBR","ZAF") =  -0.0225 ; !   0.181% ->   0.158%
shock tms("MachEquip","ROW","ZAF") =  -0.2032 ; !   1.653% ->   1.446%
shock tms("ChemPlast","USA","ZAF") =  -0.3538 ; !  13.204% ->  12.804%  [cut + retaliation]
shock tms("ChemPlast","CHN","ZAF") =  -0.6316 ; !   5.322% ->   4.657%
shock tms("ChemPlast","EU27","ZAF") =  -0.0616 ; !   0.496% ->   0.434%
shock tms("ChemPlast","GBR","ZAF") =  -0.0163 ; !   0.130% ->   0.114%
shock tms("ChemPlast","ROW","ZAF") =  -0.3241 ; !   2.662% ->   2.329%
shock tms("TexApp","USA","ZAF") =  -1.3823 ; !  23.677% ->  21.967%  [cut + retaliation]
shock tms("TexApp","SACUSADC","ZAF") =  -0.0000 ; !   0.000% ->   0.000%
shock tms("TexApp","CHN","ZAF") =  -2.5022 ; !  25.027% ->  21.899%
shock tms("TexApp","EU27","ZAF") =  -1.2508 ; !  11.119% ->   9.729%
shock tms("TexApp","GBR","ZAF") =  -1.3169 ; !  11.776% ->  10.304%
shock tms("TexApp","ROW","ZAF") =  -1.9404 ; !  18.375% ->  16.078%
shock tms("OthManuf","USA","ZAF") =  -0.2965 ; !  12.673% ->  12.339%  [cut + retaliation]
shock tms("OthManuf","CHN","ZAF") =  -0.6082 ; !   5.114% ->   4.475%
shock tms("OthManuf","EU27","ZAF") =  -0.1185 ; !   0.957% ->   0.837%
shock tms("OthManuf","GBR","ZAF") =  -0.1485 ; !   1.202% ->   1.052%
shock tms("OthManuf","ROW","ZAF") =  -0.3314 ; !   2.724% ->   2.383%
shock tms("Utilities","USA","ZAF") =   0.0000 ; !  10.000% ->  10.000%  [cut + retaliation]
shock tms("Construct","USA","ZAF") =   0.0000 ; !  10.000% ->  10.000%  [cut + retaliation]
shock tms("TradeTran","USA","ZAF") =   0.0000 ; !  10.000% ->  10.000%  [cut + retaliation]
shock tms("BusSvc","USA","ZAF") =   0.0000 ; !  10.000% ->  10.000%  [cut + retaliation]
shock tms("PubOthSvc","USA","ZAF") =   0.0000 ; !  10.000% ->  10.000%  [cut + retaliation]

!======================================================================
! DSM realistic export opportunity targets (Q2 + Q3)
!======================================================================
! qxs is exogenous under POL3 and ams is the endogenous residual.
! ams is therefore a CALIBRATED OUTCOME reporting the effective
! market-access improvement required to deliver these volumes.
! Values are the authors' DSM output after the realisation
! discounts of Section 4.7.6.  ZAF->USA is excluded by assumption.
! MUST be 'tshock': qxs is exogenous under POL3, so RunDynam also
! writes a base-case shock for it.  'tshock' supplies the TOTAL
! value and replaces the base-case statement; 'shock' would clash.
!======================================================================

! tshock qxs("Auto","ZAF","CHN") =   2.6010 ;   ! EXCLUDED (DSM scope / materiality)
tshock qxs("ChemPlast","ZAF","CHN") =   8.8711 ;
! tshock qxs("Coal","ZAF","CHN") =  16.1799 ;   ! EXCLUDED (DSM scope / materiality)
